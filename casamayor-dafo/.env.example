# ---------------------------------------------------------------------------
# DAFO de vivienda (herramienta interna de Inmobiliaria Casamayor)
# ---------------------------------------------------------------------------

# --- Acceso del equipo (OBLIGATORIAS) ---
# Sin estas dos la aplicación no deja entrar a nadie (responde 503): es a
# propósito, preferimos que no funcione a que se quede abierta.
#
# Contraseña única que comparte todo el equipo. Es la misma que la de la
# calculadora (casamayor-calculadora).
CLAVE_EQUIPO=
# Secreto con el que se firma la cookie de sesión (HMAC-SHA256). Genera uno con:
#   openssl rand -base64 48
# Si lo cambias, se cierran todas las sesiones abiertas y hay que volver a entrar.
COOKIE_SECRET=
