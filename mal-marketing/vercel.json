{
  "rewrites": [
    { "source": "/restaurantes", "destination": "/restaurantes.html" },
    { "source": "/restaurantes/semaforo", "destination": "/semaforo.html" },
    { "source": "/restaurantes/semaforo/verde", "destination": "/semaforo-verde.html" },
    { "source": "/restaurantes/semaforo/ambar", "destination": "/semaforo-ambar.html" },
    { "source": "/restaurantes/semaforo/rojo", "destination": "/semaforo-rojo.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
